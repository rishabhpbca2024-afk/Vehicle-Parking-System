<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/navbar') %>

<div class="card-modern">
    <div class="card-modern-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h5 class="fw-bold text-white mb-0"><i class="bi bi-calendar-check me-2 text-info"></i>Daily Financial & Operations Audit</h5>
            <small class="text-secondary">Summary of vehicular movements and verified revenues for <%= selectedDate %></small>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-outline-light btn-sm" onclick="window.print()">
                <i class="bi bi-printer me-1"></i>Print Report
            </button>
        </div>
    </div>

    <div class="card-modern-body pb-0">
        <!-- Date Picker Form -->
        <form method="GET" action="/reports/daily" class="row g-2 mb-4 align-items-center">
            <div class="col-sm-4 col-md-3">
                <label class="form-label text-secondary small mb-1">Select Audit Date:</label>
                <input type="date" class="form-control" name="report_date" value="<%= selectedDate %>">
            </div>
            <div class="col-sm-3 col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-arrow-repeat me-1"></i>Generate</button>
            </div>
        </form>

        <!-- KPI Summary Cards -->
        <div class="row g-3 mb-4">
            <div class="col-sm-4">
                <div class="p-3 rounded bg-dark border border-secondary text-center">
                    <small class="text-secondary text-uppercase d-block" style="font-size: 0.72rem;">Vehicles Checked-in</small>
                    <h3 class="fw-bold text-white mb-0 mt-1"><%= dailyEntries %></h3>
                    <small class="text-info"><i class="bi bi-box-arrow-in-down-right me-1"></i>Arrivals</small>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="p-3 rounded bg-dark border border-secondary text-center">
                    <small class="text-secondary text-uppercase d-block" style="font-size: 0.72rem;">Vehicles Checked-out</small>
                    <h3 class="fw-bold text-white mb-0 mt-1"><%= dailyExits %></h3>
                    <small class="text-danger"><i class="bi bi-box-arrow-right me-1"></i>Departures</small>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="p-3 rounded bg-dark border border-success text-center">
                    <small class="text-secondary text-uppercase d-block" style="font-size: 0.72rem;">Total Revenue Collected</small>
                    <h3 class="fw-bold text-success mb-0 mt-1 font-monospace"><%= formatCurrency(dailyRevenue) %></h3>
                    <small class="text-success"><i class="bi bi-check2-circle me-1"></i>Verified Paid</small>
                </div>
            </div>
        </div>

        <!-- Breakdown Section -->
        <div class="row g-3 mb-4">
            <!-- Vehicle Breakdown -->
            <div class="col-md-6">
                <div class="p-3 rounded bg-dark border border-secondary h-100">
                    <h6 class="fw-bold text-white mb-3"><i class="bi bi-pie-chart-fill me-2 text-primary"></i>Revenue by Category</h6>
                    <div class="table-responsive">
                        <table class="table table-dark table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Category</th>
                                    <th>Entries</th>
                                    <th class="text-end">Revenue</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (typeBreakdown.length === 0) { %>
                                    <tr><td colspan="3" class="text-center text-secondary py-3">No activity recorded</td></tr>
                                <% } else { %>
                                    <% typeBreakdown.forEach(function(tb) { 
                                        const vMeta = vehicleTypesMap[tb.vehicle_type] || { short: tb.vehicle_type };
                                    %>
                                        <tr>
                                            <td><%= vMeta.short %></td>
                                            <td><%= tb.sessions_count %></td>
                                            <td class="text-end font-monospace text-success"><%= formatCurrency(tb.total_rev) %></td>
                                        </tr>
                                    <% }); %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Payment Breakdown -->
            <div class="col-md-6">
                <div class="p-3 rounded bg-dark border border-secondary h-100">
                    <h6 class="fw-bold text-white mb-3"><i class="bi bi-credit-card-2-front-fill me-2 text-info"></i>Collections by Method</h6>
                    <div class="table-responsive">
                        <table class="table table-dark table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Instrument</th>
                                    <th>Transactions</th>
                                    <th class="text-end">Total Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (methodBreakdown.length === 0) { %>
                                    <tr><td colspan="3" class="text-center text-secondary py-3">No payments recorded</td></tr>
                                <% } else { %>
                                    <% methodBreakdown.forEach(function(mb) { 
                                        const mMeta = paymentMethods[mb.method] || { label: mb.method };
                                    %>
                                        <tr>
                                            <td><%= mMeta.label %></td>
                                            <td><%= mb.tx_count %></td>
                                            <td class="text-end font-monospace text-success"><%= formatCurrency(mb.total_amount) %></td>
                                        </tr>
                                    <% }); %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sessions Activity Table -->
    <div class="table-responsive">
        <table class="table table-custom mb-0">
            <thead>
                <tr>
                    <th>Ticket #</th>
                    <th>Vehicle Reg.</th>
                    <th>Category</th>
                    <th>Slot</th>
                    <th>Entry Time</th>
                    <th>Exit Time</th>
                    <th>Amount</th>
                    <th>Method</th>
                    <th>Staff</th>
                </tr>
            </thead>
            <tbody>
                <% if (daySessions.length === 0) { %>
                    <tr>
                        <td colspan="9" class="text-center py-5 text-secondary">
                            <i class="bi bi-inbox display-5 d-block mb-2 text-muted"></i>
                            No parking sessions on <%= selectedDate %>.
                        </td>
                    </tr>
                <% } else { %>
                    <% daySessions.forEach(function(sess) { 
                        const vMeta = vehicleTypesMap[sess.vehicle_type] || { short: sess.vehicle_type, badge: 'badge-car' };
                    %>
                        <tr>
                            <td class="fw-bold text-white font-monospace">TKT-<%= String(sess.id).padStart(6, '0') %></td>
                            <td><span class="fw-bold text-white font-monospace"><%= sess.registration_number %></span></td>
                            <td><span class="badge <%= vMeta.badge %>"><%= vMeta.short %></span></td>
                            <td><span class="badge bg-dark border border-secondary"><%= sess.slot_number %></span></td>
                            <td class="small text-secondary"><%= formatDateTime(sess.entry_time) %></td>
                            <td class="small text-secondary"><%= sess.exit_time ? formatDateTime(sess.exit_time) : 'Still Parked' %></td>
                            <td>
                                <% if (sess.status === 'COMPLETED') { %>
                                    <strong class="text-success font-monospace"><%= formatCurrency(sess.amount) %></strong>
                                <% } else { %>
                                    <span class="badge bg-danger-subtle text-danger">Active</span>
                                <% } %>
                            </td>
                            <td><span class="badge bg-secondary"><%= sess.payment_method || '—' %></span></td>
                            <td class="small text-secondary"><%= sess.operator_name || 'System' %></td>
                        </tr>
                    <% }); %>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../partials/footer') %>
