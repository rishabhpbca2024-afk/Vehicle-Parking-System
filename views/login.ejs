<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %> — <%= appName %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #0b0f19;
            color: #f1f5f9;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Inter', sans-serif;
            padding: 1.5rem;
        }
        .login-card {
            background: #111827;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 1.25rem;
            max-width: 480px;
            width: 100%;
            overflow: hidden;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
        }
        .login-header {
            background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%);
            padding: 2rem;
            text-align: center;
            color: #ffffff;
        }
        .brand-icon {
            width: 52px;
            height: 52px;
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(8px);
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 0.75rem;
            font-size: 1.6rem;
        }
        .demo-showcase-box {
            background: rgba(99, 102, 241, 0.08);
            border: 1px dashed #6366f1;
            border-radius: 0.75rem;
            padding: 1rem;
            margin-bottom: 1.5rem;
        }
        .form-control {
            background-color: #1e293b;
            border-color: rgba(255, 255, 255, 0.12);
            color: #ffffff;
            padding: 0.75rem 1rem;
        }
        .form-control:focus {
            background-color: #1e293b;
            border-color: #6366f1;
            color: #ffffff;
            box-shadow: 0 0 0 0.25rem rgba(99, 102, 241, 0.25);
        }
        .form-label {
            font-size: 0.875rem;
            font-weight: 500;
            color: #94a3b8;
        }
    </style>
</head>
<body>

<div class="login-card">
    <div class="login-header">
        <div class="brand-icon">
            <i class="bi bi-p-square-fill"></i>
        </div>
        <h3 class="fw-bold mb-1">SmartPark</h3>
        <p class="mb-0 text-white-50 small">Vehicle Parking Management System • Node.js Edition</p>
    </div>

    <div class="p-4 p-md-4">
        <!-- Flash Messages -->
        <% if (flash) { %>
            <% Object.keys(flash).forEach(function(type) { %>
                <% if (flash[type] && flash[type].length > 0) { %>
                    <% flash[type].forEach(function(msg) { %>
                        <div class="alert alert-<%= type %> alert-dismissible fade show small" role="alert">
                            <%= msg %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    <% }); %>
                <% } %>
            <% }); %>
        <% } %>

        <!-- Recruiter / Live Demo 1-Click Access Panel -->
        <div class="demo-showcase-box">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="badge bg-warning text-dark fw-bold px-2 py-1">
                    <i class="bi bi-stars me-1"></i>RECRUITER & PORTFOLIO DEMO
                </span>
                <small class="text-secondary" style="font-size: 0.72rem;">Instant 1-Click Login</small>
            </div>
            <p class="small text-secondary mb-3" style="font-size: 0.8rem;">
                No manual registration required. Test all live features (Vehicle Entry, Ticket Printing, PhonePe QR Checkout, Rates, and Reports) using the demo personas:
            </p>
            <div class="row g-2">
                <div class="col-6">
                    <a href="/demo-login/admin" class="btn btn-sm btn-outline-danger w-100 fw-bold py-2 d-flex flex-column align-items-center justify-content-center">
                        <div><i class="bi bi-shield-check fs-6 me-1"></i>Admin Demo</div>
                        <small class="fw-normal text-muted" style="font-size: 0.68rem;">Rishabh Pal (Full Access)</small>
                    </a>
                </div>
                <div class="col-6">
                    <a href="/demo-login/operator" class="btn btn-sm btn-outline-primary w-100 fw-bold py-2 d-flex flex-column align-items-center justify-content-center">
                        <div><i class="bi bi-person-workspace fs-6 me-1"></i>Operator Demo</div>
                        <small class="fw-normal text-muted" style="font-size: 0.68rem;">Muskan (Desk Console)</small>
                    </a>
                </div>
            </div>
        </div>

        <div class="position-relative text-center my-3">
            <hr class="border-secondary">
            <span class="position-absolute top-50 start-50 translate-middle bg-dark px-3 text-secondary small">or sign in manually</span>
        </div>

        <form method="POST" action="/login" autocomplete="off">
            <div class="mb-3">
                <label for="email" class="form-label">Email Address</label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-envelope"></i></span>
                    <input type="email" class="form-control" id="email" name="email" required autofocus
                           placeholder="user@smartpark.local" value="<%= email %>">
                </div>
            </div>

            <div class="mb-4">
                <label for="password" class="form-label">Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-lock"></i></span>
                    <input type="password" class="form-control" id="password" name="password" required
                           placeholder="Enter your password">
                </div>
                <div class="d-flex justify-content-between mt-1">
                    <small class="text-secondary" style="font-size: 0.72rem;">Admin: <code>Rishabh@2218</code></small>
                    <small class="text-secondary" style="font-size: 0.72rem;">Operator: <code>operator123</code></small>
                </div>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary btn-lg fw-semibold">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                </button>
            </div>
        </form>

        <div class="mt-4 pt-3 text-center border-top border-secondary-subtle">
            <small class="text-secondary">
                Protected parking operations console &copy; <%= new Date().getFullYear() %> • Node.js & MySQL
            </small>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

