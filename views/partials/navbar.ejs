<main class="app-main">
    <header class="app-navbar">
        <div class="d-flex align-items-center">
            <button id="sidebar-toggle" class="btn btn-dark btn-sm d-lg-none me-3" type="button" aria-label="Toggle navigation">
                <i class="bi bi-list fs-5"></i>
            </button>
            <h5 class="fw-bold mb-0 text-white d-none d-sm-block"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Dashboard' %></h5>
        </div>

        <div class="d-flex align-items-center gap-2 gap-sm-3">
            <!-- Digital Real-time Clock -->
            <div class="live-clock-badge d-none d-md-flex align-items-center">
                <i class="bi bi-clock me-2"></i>
                <span id="live-clock">Loading time...</span>
            </div>

            <!-- Theme Toggle Button (Dark / Light) -->
            <button id="theme-toggle" class="btn btn-dark btn-sm border-secondary d-flex align-items-center" type="button" title="Toggle Light / Dark Mode">
                <i class="bi bi-moon-stars-fill" id="theme-icon"></i>
            </button>

            <!-- Quick Vehicle Check-in Action -->
            <a href="/vehicles/entry" class="btn btn-primary btn-sm d-flex align-items-center">
                <i class="bi bi-plus-circle me-1"></i>
                <span class="d-none d-sm-inline">New Entry</span>
            </a>

            <!-- Recruiter Role Switcher (If in Demo mode) -->
            <% if (currentUser && currentUser.isDemo) { %>
                <div class="dropdown d-none d-md-block">
                    <button class="btn btn-sm btn-outline-warning dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        <i class="bi bi-person-badge me-1"></i>Demo Mode
                    </button>
                    <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow border-warning">
                        <li class="dropdown-header text-warning small">Switch Recruiter Demo Persona:</li>
                        <li><a class="dropdown-item py-1" href="/demo-login/admin"><i class="bi bi-shield-check text-danger me-2"></i>Switch to Admin (Rishabh)</a></li>
                        <li><a class="dropdown-item py-1" href="/demo-login/operator"><i class="bi bi-person-workspace text-primary me-2"></i>Switch to Operator (Muskan)</a></li>
                    </ul>
                </div>
            <% } %>

            <!-- User Dropdown Menu -->
            <div class="dropdown">
                <button class="btn btn-dark btn-sm dropdown-toggle border-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-person-circle me-1 text-primary"></i>
                    <span class="d-none d-sm-inline"><%= currentUser ? currentUser.name : 'Account' %></span>
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow-lg border-secondary">
                    <li class="px-3 py-2 border-bottom border-secondary">
                        <div class="fw-semibold text-white"><%= currentUser ? currentUser.name : '' %></div>
                        <div class="small text-secondary"><%= currentUser ? currentUser.email : '' %></div>
                    </li>
                    <li>
                        <a class="dropdown-item py-2" href="/profile">
                            <i class="bi bi-person-gear me-2 text-info"></i>My Profile
                        </a>
                    </li>
                    <li><hr class="dropdown-divider border-secondary"></li>
                    <li>
                        <a class="dropdown-item py-2 text-danger" href="/logout">
                            <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <div class="content-body">
        <% if (currentUser && currentUser.isDemo) { %>
            <div class="alert alert-warning py-2 px-3 mb-3 border-warning d-flex align-items-center justify-content-between flex-wrap gap-2 shadow-sm">
                <div class="d-flex align-items-center gap-2 small">
                    <span class="badge bg-warning text-dark fw-bold">RECRUITER DEMO SANDBOX</span>
                    <span>You are testing as <strong><%= currentUser.name %></strong> (<%= currentUser.role %>). Feel free to park vehicles, checkout, scan UPI, and print receipts!</span>
                </div>
                <div class="d-flex gap-2">
                    <% if (currentUser.role === 'ADMIN') { %>
                        <a href="/demo-login/operator" class="btn btn-xs btn-outline-dark fw-semibold py-0 px-2" style="font-size: 0.75rem;">Switch to Operator View</a>
                    <% } else { %>
                        <a href="/demo-login/admin" class="btn btn-xs btn-outline-dark fw-semibold py-0 px-2" style="font-size: 0.75rem;">Switch to Admin View</a>
                    <% } %>
                    <a href="/logout" class="btn btn-xs btn-danger fw-semibold py-0 px-2" style="font-size: 0.75rem;">Exit Demo</a>
                </div>
            </div>
        <% } %>

        <% if (flash) { %>
            <% Object.keys(flash).forEach(function(type) { %>
                <% if (flash[type] && flash[type].length > 0) { %>
                    <% flash[type].forEach(function(msg) { %>
                        <div class="alert alert-<%= type %> alert-dismissible fade show d-flex align-items-center" role="alert">
                            <% if (type === 'success') { %>
                                <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                            <% } else if (type === 'danger') { %>
                                <i class="bi bi-exclamation-octagon-fill me-2 fs-5"></i>
                            <% } else if (type === 'warning') { %>
                                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                            <% } else { %>
                                <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                            <% } %>
                            <div><%= msg %></div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    <% }); %>
                <% } %>
            <% }); %>
        <% } %>
