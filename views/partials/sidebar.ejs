<aside class="app-sidebar">
    <div class="sidebar-brand">
        <div class="brand-logo-icon">
            <i class="bi bi-p-square-fill"></i>
        </div>
        <div>
            <h6 class="fw-bold mb-0 text-white tracking-wide">SmartPark</h6>
            <small class="text-secondary" style="font-size: 0.72rem;">PARKING MANAGEMENT</small>
        </div>
    </div>

    <div class="sidebar-nav">
        <div class="sidebar-heading">Core Operations</div>
        
        <a href="/dashboard" class="nav-link-custom <%= (typeof activeNav !== 'undefined' && activeNav === 'dashboard') ? 'active' : '' %>">
            <i class="bi bi-grid-1x2-fill"></i>
            <span>Dashboard</span>
        </a>

        <a href="/vehicles/entry" class="nav-link-custom <%= (typeof activeNav !== 'undefined' && activeNav === 'entry') ? 'active' : '' %>">
            <i class="bi bi-box-arrow-in-down-right"></i>
            <span>Vehicle Entry</span>
        </a>

        <a href="/vehicles/active" class="nav-link-custom <%= (typeof activeNav !== 'undefined' && activeNav === 'active') ? 'active' : '' %>">
            <i class="bi bi-clock-history"></i>
            <span>Active Parking</span>
        </a>

        <a href="/slots" class="nav-link-custom <%= (typeof activeNav !== 'undefined' && activeNav === 'slots') ? 'active' : '' %>">
            <i class="bi bi-p-circle-fill"></i>
            <span>Parking Slots</span>
        </a>

        <div class="sidebar-heading">Records & Billing</div>

        <a href="/vehicles/history" class="nav-link-custom <%= (typeof activeNav !== 'undefined' && activeNav === 'history') ? 'active' : '' %>">
            <i class="bi bi-journal-text"></i>
            <span>Parking History</span>
        </a>

        <a href="/payments" class="nav-link-custom <%= (typeof activeNav !== 'undefined' && activeNav === 'payments') ? 'active' : '' %>">
            <i class="bi bi-receipt"></i>
            <span>Payments Log</span>
        </a>

        <div class="sidebar-heading">Analytics & Reports</div>

        <a href="/reports/daily" class="nav-link-custom <%= (typeof activeNav !== 'undefined' && activeNav === 'reports_daily') ? 'active' : '' %>">
            <i class="bi bi-calendar-check"></i>
            <span>Daily Report</span>
        </a>

        <a href="/reports/monthly" class="nav-link-custom <%= (typeof activeNav !== 'undefined' && activeNav === 'reports_monthly') ? 'active' : '' %>">
            <i class="bi bi-bar-chart-line-fill"></i>
            <span>Monthly Report</span>
        </a>

        <% if (currentUser && currentUser.role === 'ADMIN') { %>
            <div class="sidebar-heading">Administration</div>

            <a href="/rates" class="nav-link-custom <%= (typeof activeNav !== 'undefined' && activeNav === 'rates') ? 'active' : '' %>">
                <i class="bi bi-currency-exchange"></i>
                <span>Parking Rates</span>
            </a>
        <% } %>
    </div>

    <div class="sidebar-user">
        <div class="user-avatar">
            <%= (currentUser && currentUser.name) ? currentUser.name.charAt(0).toUpperCase() : 'U' %>
        </div>
        <div class="flex-grow-1 overflow-hidden me-2">
            <div class="fw-semibold text-truncate small text-white"><%= currentUser ? currentUser.name : 'User' %></div>
            <div class="d-flex align-items-center">
                <span class="badge <%= (currentUser && currentUser.role === 'ADMIN') ? 'bg-danger' : 'bg-primary' %> py-0 px-1" style="font-size: 0.68rem;">
                    <%= currentUser ? currentUser.role : 'OPERATOR' %>
                </span>
                <% if (currentUser && currentUser.isDemo) { %>
                    <span class="badge bg-warning text-dark py-0 px-1 ms-1" style="font-size: 0.65rem;">DEMO</span>
                <% } %>
            </div>
        </div>
        <a href="/logout" class="text-secondary text-decoration-none hover-light" title="Sign Out">
            <i class="bi bi-box-arrow-right fs-5"></i>
        </a>
    </div>
</aside>

