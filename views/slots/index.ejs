<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/navbar') %>

<div class="card-modern">
    <div class="card-modern-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h5 class="fw-bold text-white mb-0"><i class="bi bi-p-circle-fill me-2 text-warning"></i>Parking Slots Management</h5>
            <small class="text-secondary">Monitor capacity, occupancy state, and physical bay allocations</small>
        </div>
        <div class="d-flex align-items-center gap-2">
            <!-- View Mode Switcher -->
            <div class="btn-group btn-group-sm" role="group">
                <a href="/slots?view=table<%= filterFloor ? '&floor=' + filterFloor : '' %><%= filterType ? '&vehicle_type=' + filterType : '' %><%= filterStatus ? '&status=' + filterStatus : '' %>" 
                   class="btn <%= viewMode === 'table' ? 'btn-primary' : 'btn-dark border-secondary' %>">
                    <i class="bi bi-table me-1"></i>Table
                </a>
                <a href="/slots?view=grid<%= filterFloor ? '&floor=' + filterFloor : '' %><%= filterType ? '&vehicle_type=' + filterType : '' %><%= filterStatus ? '&status=' + filterStatus : '' %>" 
                   class="btn <%= viewMode === 'grid' ? 'btn-primary' : 'btn-dark border-secondary' %>">
                    <i class="bi bi-grid-3x3-gap me-1"></i>Visual Grid
                </a>
            </div>

            <% if (currentUser && currentUser.role === 'ADMIN') { %>
                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addSlotModal">
                    <i class="bi bi-plus-circle me-1"></i>Add Slot
                </button>
            <% } %>
        </div>
    </div>

    <div class="card-modern-body pb-0">
        <!-- Filter Bar -->
        <form method="GET" action="/slots" class="row g-2 mb-4">
            <input type="hidden" name="view" value="<%= viewMode %>">
            <div class="col-md-3">
                <input type="text" class="form-control" name="search" placeholder="Search slot number..." value="<%= searchSlot %>">
            </div>
            <div class="col-md-3">
                <select class="form-select" name="floor">
                    <option value="">All Floor Levels</option>
                    <% availableFloors.forEach(function(fl) { %>
                        <option value="<%= fl %>" <%= filterFloor === fl ? 'selected' : '' %>><%= fl %></option>
                    <% }); %>
                </select>
            </div>
            <div class="col-md-3">
                <select class="form-select" name="vehicle_type">
                    <option value="">All Vehicle Categories</option>
                    <% for (const [vKey, vMeta] of Object.entries(vehicleTypesMap)) { %>
                        <option value="<%= vKey %>" <%= filterType === vKey ? 'selected' : '' %>><%= vMeta.label %></option>
                    <% } %>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i>Filter</button>
                <% if (searchSlot || filterFloor || filterType || filterStatus) { %>
                    <a href="/slots?view=<%= viewMode %>" class="btn btn-outline-secondary" title="Reset Filters"><i class="bi bi-x-lg"></i></a>
                <% } %>
            </div>
        </form>
    </div>

    <% if (viewMode === 'grid') { %>
        <!-- Visual Grid View -->
        <div class="card-modern-body pt-0">
            <div class="row g-3">
                <% if (slots.length === 0) { %>
                    <div class="col-12 text-center py-5 text-secondary">
                        <i class="bi bi-inbox display-5 d-block mb-2 text-muted"></i>
                        No parking slots match the selected filters.
                    </div>
                <% } else { %>
                    <% slots.forEach(function(s) { 
                        const vMeta = vehicleTypesMap[s.vehicle_type] || { short: s.vehicle_type, icon: 'bi-car-front' };
                        let cardBorder = 'border-success';
                        let badgeBg = 'bg-success';
                        if (s.status === 'OCCUPIED') {
                            cardBorder = 'border-danger';
                            badgeBg = 'bg-danger';
                        } else if (s.status === 'OUT_OF_SERVICE') {
                            cardBorder = 'border-secondary';
                            badgeBg = 'bg-secondary';
                        }
                    %>
                        <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
                            <div class="p-3 rounded bg-dark border <%= cardBorder %> text-center h-100 d-flex flex-column justify-content-between shadow-sm">
                                <div>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <small class="text-secondary"><%= s.floor_number %></small>
                                        <span class="badge <%= badgeBg %>" style="font-size: 0.65rem;"><%= s.status %></span>
                                    </div>
                                    <h4 class="fw-bold font-monospace text-white mb-1"><%= s.slot_number %></h4>
                                    <small class="text-info d-block mb-2">
                                        <i class="bi <%= vMeta.icon %> me-1"></i><%= vMeta.short %>
                                    </small>
                                </div>
                                <div class="pt-2 border-top border-secondary-subtle">
                                    <% if (s.status === 'OCCUPIED' && s.active_reg_number) { %>
                                        <span class="badge bg-danger-subtle text-danger font-monospace text-truncate w-100 d-block">
                                            <%= s.active_reg_number %>
                                        </span>
                                    <% } else if (s.status === 'AVAILABLE') { %>
                                        <span class="text-success small fw-semibold">Ready to Park</span>
                                    <% } else { %>
                                        <span class="text-muted small">Under Maintenance</span>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } %>
            </div>
        </div>
    <% } else { %>
        <!-- Detailed Table View -->
        <div class="table-responsive">
            <table class="table table-custom mb-0">
                <thead>
                    <tr>
                        <th>Slot Identifier</th>
                        <th>Floor Level</th>
                        <th>Designated Vehicle Category</th>
                        <th>Occupancy State</th>
                        <th>Current Occupant</th>
                        <% if (currentUser && currentUser.role === 'ADMIN') { %>
                            <th class="text-end">Management</th>
                        <% } %>
                    </tr>
                </thead>
                <tbody>
                    <% if (slots.length === 0) { %>
                        <tr>
                            <td colspan="6" class="text-center py-5 text-secondary">
                                <i class="bi bi-inbox display-5 d-block mb-2 text-muted"></i>
                                No parking slots found.
                            </td>
                        </tr>
                    <% } else { %>
                        <% slots.forEach(function(s) { 
                            const vMeta = vehicleTypesMap[s.vehicle_type] || { short: s.vehicle_type, badge: 'badge-car', icon: 'bi-car-front' };
                            const sMeta = slotStatusesMap[s.status] || { label: s.status, badge: 'bg-secondary' };
                        %>
                            <tr>
                                <td class="fw-bold text-white font-monospace fs-6"><%= s.slot_number %></td>
                                <td><%= s.floor_number %></td>
                                <td>
                                    <span class="badge <%= vMeta.badge %>">
                                        <i class="bi <%= vMeta.icon %> me-1"></i><%= vMeta.short %>
                                    </span>
                                </td>
                                <td>
                                    <span class="badge <%= sMeta.badge %>"><%= sMeta.label %></span>
                                </td>
                                <td>
                                    <% if (s.status === 'OCCUPIED' && s.active_reg_number) { %>
                                        <a href="/vehicles/checkout/<%= s.active_session_id %>" class="fw-bold text-info font-monospace text-decoration-none">
                                            <%= s.active_reg_number %> <i class="bi bi-box-arrow-up-right ms-1 small"></i>
                                        </a>
                                    <% } else { %>
                                        <span class="text-secondary">—</span>
                                    <% } %>
                                </td>
                                <% if (currentUser && currentUser.role === 'ADMIN') { %>
                                    <td class="text-end">
                                        <% if (s.status !== 'OCCUPIED') { %>
                                            <form method="POST" action="/slots/toggle-status" class="d-inline">
                                                <input type="hidden" name="slot_id" value="<%= s.id %>">
                                                <% if (s.status === 'AVAILABLE') { %>
                                                    <input type="hidden" name="status" value="OUT_OF_SERVICE">
                                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Mark Out of Service">
                                                        <i class="bi bi-slash-circle me-1"></i>Disable
                                                    </button>
                                                <% } else { %>
                                                    <input type="hidden" name="status" value="AVAILABLE">
                                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Mark Available">
                                                        <i class="bi bi-check-circle me-1"></i>Enable
                                                    </button>
                                                <% } %>
                                            </form>
                                        <% } else { %>
                                            <span class="badge bg-dark border border-secondary text-secondary">In Use</span>
                                        <% } %>
                                    </td>
                                <% } %>
                            </tr>
                        <% }); %>
                    <% } %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>

<!-- Modal: Add Slot (Admin Only) -->
<% if (currentUser && currentUser.role === 'ADMIN') { %>
    <div class="modal fade" id="addSlotModal" tabindex="-1" aria-labelledby="addSlotModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content card-modern">
                <div class="modal-header border-bottom border-secondary-subtle">
                    <h5 class="modal-title fw-bold text-white" id="addSlotModalLabel"><i class="bi bi-plus-circle me-2 text-primary"></i>Add Parking Space</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="POST" action="/slots/add">
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label for="slot_number" class="form-label">Slot Identifier</label>
                            <input type="text" class="form-control font-monospace fw-bold" id="slot_number" name="slot_number" placeholder="e.g. F1-15 or B2-01" required>
                        </div>
                        <div class="mb-3">
                            <label for="floor_number" class="form-label">Floor / Level</label>
                            <input type="text" class="form-control" id="floor_number" name="floor_number" placeholder="e.g. 1st Floor or Basement 1" required>
                        </div>
                        <div class="mb-3">
                            <label for="vehicle_type" class="form-label">Designated Vehicle Category</label>
                            <select class="form-select" id="vehicle_type" name="vehicle_type" required>
                                <% for (const [vKey, vMeta] of Object.entries(vehicleTypesMap)) { %>
                                    <option value="<%= vKey %>"><%= vMeta.label %></option>
                                <% } %>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer border-top border-secondary-subtle">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary fw-bold"><i class="bi bi-check-circle me-1"></i>Create Slot</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
<% } %>

<%- include('../partials/footer') %>

