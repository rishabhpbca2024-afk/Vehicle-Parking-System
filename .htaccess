# Prevent Directory Listing
Options -Indexes

# Protect Sensitive Configuration and Environment Files
<FilesMatch "^\.env|\.git|\.gitignore|composer\.(json|lock)|README\.md|package(-lock)?\.json$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Protect SQL Schema and Logs
<FilesMatch "\.(sql|log|bak|ini|sh|bat)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block Direct Access to Database and Config Directories
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^config/ - [F,L]
    RewriteRule ^database/ - [F,L]
</IfModule>

# Set UTF-8 encoding
AddDefaultCharset UTF-8
